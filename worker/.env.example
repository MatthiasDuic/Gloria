# --- Server ---
PORT=8080
LOG_LEVEL=info

# --- Provider keys ---
OPENAI_API_KEY=
TELNYX_STREAM_BIDIRECTIONAL_CODEC=PCMA
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v4_turbo
ELEVENLABS_FALLBACK_MODEL=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.27
ELEVENLABS_SIMILARITY=0.86
ELEVENLABS_STYLE=0.62
ELEVENLABS_SPEED=0.90
ELEVENLABS_SPEAKER_BOOST=false
ELEVENLABS_STREAMING_LATENCY=2

# --- Realtime tuning (latency + flow) ---
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_REASONING_EFFORT=low
OPENAI_REALTIME_MAX_OUTPUT_TOKENS=220
OPENAI_REALTIME_VAD_THRESHOLD=0.75
OPENAI_REALTIME_SILENCE_MS=650
OPENAI_REALTIME_PREFIX_PADDING_MS=300
OPENAI_RESPONSE_COOLDOWN_MS=40

# --- App callback (Vercel) ---
# Worker POSTs final transcripts/outcomes here (same Postgres-backed app).
APP_BASE_URL=https://gloria.agentur-duic-sprockhoevel.de
APP_INTERNAL_TOKEN=

# --- Ausfallschutz ---
# Ersatzstimme (OpenAI TTS), falls ElevenLabs für eine Antwort kein Audio liefert.
FALLBACK_TTS_ENABLED=true
FALLBACK_TTS_MODEL=gpt-4o-mini-tts
FALLBACK_TTS_VOICE=coral
# Guthaben-Prüfung für OpenAI (ms) und das dafür genutzte Modell.
OPENAI_CREDIT_PROBE_MS=300000
OPENAI_CREDIT_PROBE_MODEL=gpt-4o-mini
# Telnyx-Check in /readyz.
TELNYX_API_KEY=
