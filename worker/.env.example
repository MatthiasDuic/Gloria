# --- Server ---
PORT=8080
LOG_LEVEL=info

# Shared HMAC secret used by Vercel <Connect><Stream> custom parameter to
# authenticate the call. Generate with: openssl rand -hex 32
STREAM_SHARED_SECRET=change-me

# --- Provider keys ---
OPENAI_API_KEY=
# gpt-4.1 = beste Gesprächsqualität | gpt-4.1-mini = schneller/günstiger
OPENAI_MODEL=gpt-4.1-mini
LLM_OPENAI_PRIMARY=1
LLM_TRANSCRIPT_TURNS=10
LLM_MAX_TOKENS=105
LLM_TIMEOUT_MS=7000
LLM_FIRST_TOKEN_TIMEOUT_MS=1600
LLM_EARLY_FLUSH_CHARS=160
LLM_COMPACT_PROMPT=1
TURN_FIRST_AUDIO_SLO_MS=2400

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# eleven_multilingual_v2 = stable, best quality DE | eleven_v3 = expressiver (neu, höhere Latenz) | eleven_flash_v2_5 = ultra-low-latency
ELEVENLABS_MODEL=eleven_multilingual_v2
GLORIA_VOICE_MODE=human
ELEVENLABS_MANUAL_VOICE_SETTINGS=false
ELEVENLABS_STABILITY=0.42
ELEVENLABS_SIMILARITY=0.9
ELEVENLABS_STYLE=0.38
ELEVENLABS_SPEED=0.92
ELEVENLABS_SPEAKER_BOOST=true
ELEVENLABS_LATENCY_MODE=1
TELNYX_STREAM_BIDIRECTIONAL_CODEC=PCMA
ASR_FINAL_COALESCE_MS=520
ASR_UTTERANCE_END_GRACE_MS=320

# --- App callback (Vercel) ---
# Worker POSTs final transcripts/outcomes here (same Postgres-backed app).
APP_BASE_URL=https://gloria.agentur-duic-sprockhoevel.de
APP_INTERNAL_TOKEN=
