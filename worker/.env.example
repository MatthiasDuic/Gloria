# --- Server ---
PORT=8080
LOG_LEVEL=info

# Shared HMAC secret used by Vercel <Connect><Stream> custom parameter to
# authenticate the call. Generate with: openssl rand -hex 32
STREAM_SHARED_SECRET=change-me

# --- Provider keys ---
OPENAI_API_KEY=
# gpt-4.1 = beste Gesprächsqualität | gpt-4.1-mini = schneller/günstiger
OPENAI_MODEL=gpt-4.1

DEEPGRAM_API_KEY=
# nova-3 = bestes Allgemein-Modell für Deutsch (Stand 2025)
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=de
# Endpointing-Tuning (Pause in ms, nach der Deepgram als Satzende interpretiert).
# 700/1200 ms ist der aktuelle Sweet Spot für deutsche Telefongespräche.
DEEPGRAM_ENDPOINTING_MS=700
DEEPGRAM_UTTERANCE_END_MS=1200
# Komma-getrennte Keyword-Hints inkl. Boost-Suffix ":Boost".
# Eigennamen des Auftraggebers hier eintragen — werden NICHT automatisch erkannt.
# Beispiel für Agentur Duic Sprockhövel:
DEEPGRAM_KEYWORDS=Duic:5,Matthias Duic:5,Sprockhövel:3

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# eleven_multilingual_v2 = stable, best quality DE | eleven_v3 = expressiver (neu, höhere Latenz) | eleven_flash_v2_5 = ultra-low-latency
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- App callback (Vercel) ---
# Worker POSTs final transcripts/outcomes here (same Postgres-backed app).
APP_BASE_URL=https://gloria.agentur-duic-sprockhoevel.de
APP_INTERNAL_TOKEN=
