# --- Server ---
PORT=8080
LOG_LEVEL=info

# Shared HMAC secret used by Vercel <Connect><Stream> custom parameter to
# authenticate the call. Generate with: openssl rand -hex 32
STREAM_SHARED_SECRET=change-me

# --- Provider keys ---
OPENAI_API_KEY=
TELNYX_STREAM_BIDIRECTIONAL_CODEC=PCMA
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.27
ELEVENLABS_SIMILARITY=0.86
ELEVENLABS_STYLE=0.62
ELEVENLABS_SPEED=0.90
ELEVENLABS_SPEAKER_BOOST=false

# --- App callback (Vercel) ---
# Worker POSTs final transcripts/outcomes here (same Postgres-backed app).
APP_BASE_URL=https://gloria.agentur-duic-sprockhoevel.de
APP_INTERNAL_TOKEN=
OPENAI_REALTIME_SPEED=0.88
