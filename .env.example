APP_BASE_URL=https://deine-oeffentliche-url.de
# Telnyx Media-Stream muss auf den Worker-WebSocket zeigen.
TELNYX_MEDIA_STREAM_URL=wss://gloria-tebr.onrender.com/telnyx-stream

BASIC_AUTH_USERNAME=MDUIC
BASIC_AUTH_PASSWORD=
CALL_STATE_SECRET=
CRON_SECRET=

DATABASE_URL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+49XXXXXXXXXX
TWILIO_SKIP_SIGNATURE_VALIDATION=false
TWILIO_SIGNATURE_DEBUG=false
TWILIO_INITIAL_GATHER_TIMEOUT_SECONDS=6
TWILIO_REPLY_GATHER_TIMEOUT_SECONDS=1
TWILIO_LISTEN_ONLY_TIMEOUT_SECONDS=3

OPENAI_API_KEY=
# Für Telefonie: gpt-4.1-mini (schnell, stabiles JSON, typ. 400-900ms,
# bessere Instruction-Following bei langen System-Prompts).
# gpt-5 ist ein Reasoning-Modell und für Live-Gespräche zu langsam.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
LIVE_AI_TIMEOUT_MS=4000
LIVE_AI_RETRY_ATTEMPTS=2

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.27
ELEVENLABS_SIMILARITY=0.86
ELEVENLABS_STYLE=0.62
ELEVENLABS_SPEED=0.90
ELEVENLABS_SPEAKER_BOOST=false
ELEVENLABS_LATENCY_MODE=3

REPORT_TO_EMAIL=Matthias.duic@agentur-duic-sprockhoevel.de
SMTP_HOST=smtp.example.de
SMTP_PORT=587
SMTP_USER=example
SMTP_PASS=secret
SMTP_FROM="Gloria <no-reply@agentur-duic-sprockhoevel.de>"

# Optional: separater Empfänger für den wöchentlichen Lernzyklus-Digest.
# Fällt sonst auf REPORT_TO_EMAIL zurück.
LEARNING_DIGEST_EMAIL=

# URL eines Health-Endpoints des Render-Workers. Wird beim prepareCall
# geringen Latenz-Druck ohne Block warmgepingt, damit der erste TwiML-Roundtrip
# nicht in einen kalten Render-Container läuft.
WORKER_HEALTHCHECK_URL=https://gloria-tebr.onrender.com/health

OUTLOOK_EXPORT_OWNER=Matthias Duic
