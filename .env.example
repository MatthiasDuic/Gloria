APP_BASE_URL=https://deine-oeffentliche-url.de
# Telnyx Media-Stream muss auf den Worker-WebSocket zeigen.
TELNYX_MEDIA_STREAM_URL=wss://gloria-tebr.onrender.com/telnyx-stream

BASIC_AUTH_USERNAME=MDUIC
BASIC_AUTH_PASSWORD=
CALL_STATE_SECRET=
CRON_SECRET=

DATABASE_URL=

# CRM server-to-server transport. Use the same random token in both apps.
# Individual CRM users pair their Gloria account in Gloria's Profile workspace.
GLORIA_CRM_INTEGRATION_TOKEN=

TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_PHONE_NUMBER=+49XXXXXXXXXX
TELNYX_PUBLIC_KEY=

OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-5.5
# Textmodell für Hintergrundaufgaben der App (Leitfaden-Optimierung, Sprachvorschau).
# Die Telefonate laufen im Worker über OpenAI Realtime, siehe worker/.env.example.
OPENAI_MODEL=gpt-4.1-mini

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v4_turbo
ELEVENLABS_FALLBACK_MODEL=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.27
ELEVENLABS_SIMILARITY=0.86
ELEVENLABS_STYLE=0.62
ELEVENLABS_SPEED=0.90
ELEVENLABS_SPEAKER_BOOST=false

REPORT_TO_EMAIL=Matthias.duic@agentur-duic-sprockhoevel.de
SMTP_HOST=smtp.example.de
SMTP_PORT=587
SMTP_USER=example
SMTP_PASS=secret
SMTP_FROM="Gloria <no-reply@agentur-duic-sprockhoevel.de>"

# Optional: separater Empfänger für den wöchentlichen Lernzyklus-Digest.
# Fällt sonst auf REPORT_TO_EMAIL zurück.
LEARNING_DIGEST_EMAIL=

# URL des Health-Endpoints des Render-Workers. Die App weckt den Worker vor
# jedem Anruf und prüft über /readyz, ob OpenAI und ElevenLabs startklar sind
# (bei aufgebrauchtem Guthaben werden Anrufe gestoppt und Kampagnen pausiert).
WORKER_HEALTHCHECK_URL=https://gloria-tebr.onrender.com/health

OUTLOOK_EXPORT_OWNER=Matthias Duic
